{
  "name": "hibi-addons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hibi addons, including the Excalidraw document format.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:excalidraw": "pnpm --filter hibi-addon-excalidraw build",
    "dev:excalidraw": "pnpm --filter hibi-addon-excalidraw dev",
    "check": "node scripts/check.mjs",
    "test": "pnpm --filter hibi-addon-excalidraw test && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "postcss": "^8.5.31"
  }
}
